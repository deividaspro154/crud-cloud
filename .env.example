# Local development can run without any environment variables:
# it will use SQLite and local static/uploads storage.

SECRET_KEY=change-me
ENABLE_SCHEDULER=true
BACKGROUND_INTERVAL_SECONDS=60

# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/product_manager

# Optional persistent cloud image storage:
# create a free Cloudinary account and copy its CLOUDINARY_URL here.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
